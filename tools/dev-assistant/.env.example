# Copy this file to .env in tools/dev-assistant. Never commit your key.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# DeepSeek Flash; replace if your provider/account uses another model.
LLM_MODEL=deepseek-flash
# Defaults to the repository containing tools/dev-assistant.
# PROJECT_ROOT=/absolute/path/to/cosplay-2
