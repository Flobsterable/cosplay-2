# Preserve byte checksums of historical experiment evidence across checkouts.
docs/ai-agent/v1/source/** -text
docs/ai-agent/v1/root-AGENTS.snapshot.md -text
docs/ai-agent/v1/generation-events.jsonl -text
docs/ai-agent/v1/generation-rollout.recovered.jsonl -text

# Preserve recorded profile evidence, including whitespace in raw command output and patches.
docs/ai-agent/profiles/evidence/** -text whitespace=cr-at-eol
